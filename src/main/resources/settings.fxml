<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.till.controller.SettingsController"
      spacing="20"
      style="-fx-padding: 30; -fx-background-color: #f5f5f5;">

    <Label text="Settings"
           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #333;"/>

    <!-- ── Appearance ──────────────────────────────────────────────────── -->
    <TitledPane text="Appearance" collapsible="false"
                style="-fx-font-size: 14; -fx-font-weight: bold;">
        <VBox spacing="16" style="-fx-padding: 16;">

            <!-- Dark Mode -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Dark Mode:" prefWidth="160"
                       style="-fx-font-size: 14;"/>
                <ToggleButton fx:id="darkModeToggle"
                              text="Off"
                              prefWidth="80" prefHeight="36"
                              onAction="#handleDarkModeToggle"
                              style="-fx-font-weight: bold;"/>
                <Label text="Darkens the entire interface to reduce eye strain."
                       style="-fx-text-fill: #777; -fx-font-size: 12;"/>
            </HBox>

            <!-- Font Size -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Text Size:" prefWidth="160"
                       style="-fx-font-size: 14;"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Button text="A"
                            onAction="#decreaseFontSize"
                            prefWidth="38" prefHeight="36"
                            style="-fx-font-size: 11; -fx-font-weight: bold; -fx-background-color: #607d8b; -fx-text-fill: white;"/>
                    <Label fx:id="fontSizeLabel" text="14 px"
                           prefWidth="55" style="-fx-font-size: 14; -fx-alignment: CENTER; -fx-font-weight: bold;"/>
                    <Button text="A"
                            onAction="#increaseFontSize"
                            prefWidth="38" prefHeight="36"
                            style="-fx-font-size: 16; -fx-font-weight: bold; -fx-background-color: #607d8b; -fx-text-fill: white;"/>
                </HBox>
                <Label text="Changes text size across the whole app."
                       style="-fx-text-fill: #777; -fx-font-size: 12;"/>
            </HBox>

        </VBox>
    </TitledPane>

    <!-- ── Spacer ─────────────────────────────────────────────────────── -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- ── Footer ────────────────────────────────────────────────────── -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Label fx:id="statusLabel" text=""
               style="-fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-font-size: 13;"/>
        <Button text="Close"
                onAction="#closeWindow"
                prefWidth="110" prefHeight="40"
                style="-fx-background-color: #757575; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

</VBox>
