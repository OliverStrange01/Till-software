<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.SplitPane?>

<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.till.controller.MainController"
            fx:id="rootPane"
            style="-fx-background-color: #d7c6c6;">

    <!-- Top header -->
    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #5d4e46; -fx-padding: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15),8,0,0,2);">
            <Label text="Till POS System"
                   style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Main content: products | cart -->
    <center>

            <HBox fx:id ="mainContent" spacing="20" style="-fx-padding: 20;">

                <!-- LEFT: keypad -->
                <VBox spacing="10" alignment="CENTER">



                </VBox>

                <!-- RIGHT: cart + actions -->
                <VBox spacing="15" HBox.hgrow="ALWAYS">

                    <!-- Cart -->


                    <!-- Actions panel -->
                    <VBox spacing="10" style="-fx-background-color: #e8ddd2; -fx-padding: 15; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #c7b9ab;">
                        <Button text="+/- items"
                                prefWidth="180" prefHeight="45"
                           style=" -fx-background-color: #8c7b75;
                            -fx-text-fill: white;
                            -fx-font-size: 14;
                            -fx-background-radius: 8;"/>
                        <Button text="Add discount"
                        prefWidth="180" prefHeight="45"
                        style="
                        -fx-background-color: #8c7b75;
                        -fx-text-fill: white;
                        -fx-font-size: 14;
                        -fx-background-radius: 8;
                        "/>
                        <Button text="Void "
                        prefWidth="180" prefHeight="45"
                        style="
                        -fx-background-color: #8c7b75;
                        -fx-text-fill: white;
                        -fx-font-size: 14;
                        -fx-background-radius: 8;
                        "/>
                        <Button text="Suspend "
                        prefWidth="180" prefHeight="45"
                        style="
                        -fx-background-color: #8c7b75;
                        -fx-text-fill: white;
                        -fx-font-size: 14;
                        -fx-background-radius: 8;
                        "/>
                        <Button text="Reprint receipt"
                                prefWidth="180" prefHeight="45"
                                style="
                        -fx-background-color: #8c7b75;
                        -fx-text-fill: white;
                        -fx-font-size: 14;
                        -fx-background-radius: 8;
                        "/>
                        <Button text="Issue refund"
                        prefWidth="180" prefHeight="45"
                        style="
                        -fx-background-color: #8c7b75;
                        -fx-text-fill: white;
                        -fx-font-size: 14;
                        -fx-background-radius: 8;
                        "/>
                    </VBox>

                </VBox>

            </HBox>

    </center>

    <!-- Bottom: payment / status area -->
    <bottom>
        <VBox spacing="12"
              style="-fx-padding: 16; -fx-background-color: #f4eee6;">

            <!-- Main Buttons -->
            <HBox spacing="20" alignment="CENTER">

                <Button text="Pay with Cash"
                        onAction="#handleCashPayment"
                        prefWidth="240" prefHeight="65"
                        style="-fx-background-color:#6fa96f;
                           -fx-text-fill:white;
                           -fx-font-size:18;
                           -fx-font-weight:bold;
                           -fx-background-radius:10;" />

                <Button text="Pay with Card"
                        onAction="#handleCardPayment"
                        prefWidth="240" prefHeight="65"
                        style="-fx-background-color:#5c8fd6;
                           -fx-text-fill:white;
                           -fx-font-size:18;
                           -fx-font-weight:bold;
                           -fx-background-radius:10;" />

                <Button text="Logout"
                        onAction="#handleLogout"
                        prefWidth="180" prefHeight="65"
                        style="-fx-background-color:#d66a5c;
                           -fx-text-fill:white;
                           -fx-font-size:18;
                           -fx-font-weight:bold;
                           -fx-background-radius:10;" />
            </HBox>

            <!-- Secondary Controls -->
            <HBox spacing="12" alignment="CENTER_LEFT">

                <Label text="Cash given:"/>
                <TextField fx:id="cashField" promptText="Enter amount" prefWidth="150"/>

                <Label text="Coupon:"/>
                <TextField fx:id="couponField" promptText="e.g. WELCOME10" prefWidth="140"/>

                <Button text="Apply Coupon"
                        onAction="#handleApplyCoupon"
                        style="-fx-background-color:#8e44ad; -fx-text-fill:white;" />

                <Button fx:id="endOfDayButton"
                        text="End of Day"
                        onAction="#handleEndOfDay" />

                <Button fx:id="adminButton"
                        text="Admin (Stock)"
                        onAction="#openAdminStock" />

                <Button fx:id="auditButton"
                        text="Audit / Queue"
                        onAction="#openAuditQueue" />
            </HBox>

            <Label fx:id="resultLabel"
                   style="-fx-font-size:16; -fx-font-weight:bold;" />

        </VBox>
    </bottom>

</BorderPane>